{
  "name": "technicalcredit",
  "displayName": "TechnicalCredit",
  "description": "Detects Technical Credit in Java code with Claude and previews it as inline annotations.",
  "publisher": "technicalcredit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cielbellerose/TechnicalCredit.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "technicalcredit.analyseForTC",
        "title": "Analyse for TC"
      },
      {
        "command": "technicalcredit.acceptTCComment",
        "title": "Technical Credit: Accept"
      },
      {
        "command": "technicalcredit.dismissTCComment",
        "title": "Technical Credit: Dismiss"
      },
      {
        "command": "technicalcredit.setApiKey",
        "title": "Technical Credit: Set API Key"
      },
      {
        "command": "technicalcredit.clearApiKey",
        "title": "Technical Credit: Clear API Key"
      }
    ],
    "configuration": {
      "title": "TechnicalCredit",
      "properties": {
        "technicalcredit.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "markdownDescription": "Claude model ID used for analysis. The `TC_MODEL` environment variable overrides this setting."
        },
        "technicalcredit.temperature": {
          "type": [
            "number",
            "null"
          ],
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "Sampling temperature. `0` keeps results as reproducible as possible. Set to `null` to omit it for models that reject the parameter. The `TC_TEMPERATURE` environment variable (a number, or `none`) overrides this setting."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "technicalcredit.analyseForTC",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "technicalcredit.acceptTCComment",
          "when": "false"
        },
        {
          "command": "technicalcredit.dismissTCComment",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run tsc:check && npm run lint:check && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run tsc:check && npm run lint:check && node esbuild.js --production",
    "pretest": "node esbuild.js",
    "test": "jest",
    "lint:check": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "tsc:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pilot": "node esbuild.js && esbuild scripts/pilot.ts --bundle --platform=node --external:@anthropic-ai/sdk --external:dotenv --alias:web-tree-sitter=./node_modules/web-tree-sitter/web-tree-sitter.cjs --outfile=dist/pilot.js --log-level=warning && node dist/pilot.js",
    "opro": "esbuild scripts/opro.ts --bundle --platform=node --external:@anthropic-ai/sdk --external:dotenv --outfile=dist/opro.js && node dist/opro.js",
    "vsix": "npx --yes @vscode/vsce@4.1.1 package"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "dotenv/config"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "isolatedModules": true
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/emscripten": "^1.41.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.x",
    "@types/vscode": "^1.138.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "anthropic-ai": "^0.0.10",
    "dotenv": "^17.4.2",
    "tree-sitter-java": "^0.23.5",
    "web-tree-sitter": "^0.27.0"
  }
}
